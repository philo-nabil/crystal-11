{
  "name": "crystal-11-avr-wizard",
  "displayName": "Crystal 11 AVR Wizard",
  "description": "AVR peripheral init code generator for ATmega32A",
  "version": "0.2.0",
  "publisher": "philo-nabil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/philo-nabil/crystal-11"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "images/icon.png",
  "categories": ["Other"],
  "keywords": ["AVR", "ATmega32A", "embedded", "microcontroller", "wizard"],
  "activationEvents": ["workspaceContains:.vscode/crystal11.json"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crystal11-sidebar",
          "title": "crystal-11 AVR Wizard",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "crystal11-sidebar": [
        {
          "id": "crystal11.welcomeView",
          "name": "AVR Wizard",
          "icon": "images/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "crystal11.welcomeView",
        "contents": "ATmega32A peripheral init code generator.\n\n[Open Code Wizard](command:crystal11.openWizard)\n\nAlready have a project?\n\n[Pick a Folder](command:vscode.openFolder)\n\n[Create New Project](command:crystal11.openWizard)"
      }
    ],
    "commands": [
      {
        "command": "crystal11.openWizard",
        "title": "crystal-11: Open AVR Code Wizard",
        "icon": "images/activity.svg"
      },
      {
        "command": "crystal11.flashDevice",
        "title": "crystal-11: Flash to Device",
        "icon": "images/activity.svg"
      },
      {
        "command": "crystal11.checkCompiler",
        "title": "crystal-11: Check avr-gcc Installation",
        "icon": "images/activity.svg"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "crystal11.flashDevice",
          "when": "resourceExtname == .hex",
          "group": "crystal11"
        }
      ]
    },
    "configuration": {
      "title": "crystal-11",
      "properties": {
        "crystal11.avrGccPath": {
          "type": "string",
          "default": "",
          "description": "Path to avr-gcc. Leave empty to auto-detect (PATH, Homebrew, apt, Arduino IDE, Microchip Studio, WinAVR, Scoop)."
        },
        "crystal11.avrdudePath": {
          "type": "string",
          "default": "",
          "description": "Path to avrdude. Leave empty to auto-detect (next to avr-gcc, PATH, Arduino IDE)."
        },
        "crystal11.avrdudePort": {
          "type": "string",
          "default": "usb",
          "description": "Port for avrdude (e.g. usb, COM3, /dev/ttyUSB0)"
        },
        "crystal11.programmer": {
          "type": "string",
          "default": "usbasp",
          "enum": ["usbasp", "avrispmkII", "arduino", "stk500"],
          "description": "ISP programmer type"
        },
        "crystal11.avrdudeExtra": {
          "type": "string",
          "default": "",
          "description": "Extra avrdude flags"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "audit": "npm audit",
    "compile": "node esbuild.js",
    "package": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@types/node": "20.11.5",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "@vscode/test-cli": "0.0.6",
    "@vscode/test-electron": "2.3.9",
    "esbuild": "0.20.2",
    "eslint": "8.57.0",
    "typescript": "5.4.5"
  }
}